#!/usr/bin/env bash
set -e

# ==============================================================================
# Git Pre-Commit Hook: zotero-tagger
# ==============================================================================

echo "🔍 Running pre-commit validation..."

# 1. Check code formatting with gofmt
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)
if [ -n "$STAGED_GO_FILES" ]; then
    UNFORMATTED=$(echo "$STAGED_GO_FILES" | xargs gofmt -s -l)
    if [ -n "$UNFORMATTED" ]; then
        echo "❌ The following staged Go files are not formatted properly with 'gofmt -s':"
        echo "$UNFORMATTED"
        echo "Run 'gofmt -s -w <file>' and stage your changes before committing."
        exit 1
    fi
else
    # Standalone execution: check all files in repo
    UNFORMATTED=$(gofmt -s -l .)
    if [ -n "$UNFORMATTED" ]; then
        echo "❌ The following Go files are not formatted properly with 'gofmt -s':"
        echo "$UNFORMATTED"
        echo "Run 'gofmt -s -w <file>' before committing."
        exit 1
    fi
fi
echo "  ✓ Code formatting (gofmt)"

# 2. Run go vet
if ! go vet ./...; then
    echo "❌ 'go vet' found issues."
    exit 1
fi
echo "  ✓ Static analysis (go vet)"

# 3. Run golangci-lint if installed
if command -v golangci-lint >/dev/null 2>&1; then
    if ! golangci-lint run; then
        echo "❌ 'golangci-lint' found issues."
        exit 1
    fi
    echo "  ✓ Linter (golangci-lint)"
fi

# 4. Run tests
if ! go test -short ./...; then
    echo "❌ Unit tests failed."
    exit 1
fi
echo "  ✓ Unit tests (go test -short)"

echo "✅ All pre-commit checks passed!"
exit 0
